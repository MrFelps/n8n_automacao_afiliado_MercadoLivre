<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Painel de Disparos - Mercado Livre</title>
  <style>
    :root {
      --ml-yellow: #FFE600;
      --ml-blue: #3483FA;
      --ml-blue-hover: #2968c8;
      --ml-dark: #333333;
      --ml-gray-light: #F5F5F5;
      --ml-gray-medium: #EBEBEB;
      --ml-gray-text: #666666;
      --ml-white: #FFFFFF;
      --ml-shadow: 0 1px 2px 0 rgba(0,0,0,.15);
      --font-family: 'Proxima Nova', -apple-system, 'Helvetica Neue', Helvetica, Roboto, Arial, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body { background-color: var(--ml-gray-light); font-family: var(--font-family); color: var(--ml-dark); -webkit-font-smoothing: antialiased; }
    .header { background-color: var(--ml-yellow); padding: 15px 30px; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--ml-shadow); position: sticky; top: 0; z-index: 10; }
    .header h1 { font-size: 22px; font-weight: 600; color: var(--ml-dark); }
    .webhook-config { display: flex; align-items: center; gap: 8px; }
    .webhook-config input { width: 420px; padding: 6px 12px; border: 2px solid rgba(0,0,0,0.2); border-radius: 4px; font-size: 12px; font-family: monospace; background: rgba(255,255,255,0.8); }
    .webhook-config input:focus { outline: none; border-color: rgba(0,0,0,0.5); background: white; }
    .webhook-label { font-size: 12px; font-weight: 700; color: var(--ml-dark); white-space: nowrap; }

    .container { max-width: 1200px; margin: 30px auto; padding: 0 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
    .card { background: var(--ml-white); border-radius: 6px; box-shadow: var(--ml-shadow); padding: 24px; display: flex; flex-direction: column; height: fit-content; }
    .card h2 { font-size: 18px; font-weight: 600; margin-bottom: 20px; color: var(--ml-dark); border-bottom: 1px solid var(--ml-gray-medium); padding-bottom: 12px; }

    .input-group { display: flex; flex-direction: column; gap: 12px; }
    textarea { width: 100%; height: 200px; padding: 14px; border: 1px solid #ccc; border-radius: 4px; font-family: monospace; font-size: 14px; resize: vertical; transition: border-color 0.2s; }
    textarea:focus { outline: none; border-color: var(--ml-blue); }
    .info-text { font-size: 13px; color: var(--ml-gray-text); }

    .btn { padding: 0 24px; height: 48px; border: none; border-radius: 4px; font-size: 16px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: background-color 0.2s, transform 0.1s; }
    .btn:active { transform: scale(0.98); }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .btn-primary { background-color: var(--ml-blue); color: var(--ml-white); }
    .btn-primary:hover:not(:disabled) { background-color: var(--ml-blue-hover); }
    .btn-yellow { background-color: var(--ml-yellow); color: var(--ml-dark); }
    .btn-yellow:hover:not(:disabled) { background-color: #f0d800; }
    .btn-danger { background-color: #FA0000; color: white; }
    .btn-danger:hover:not(:disabled) { background-color: #d10000; }

    .controls { display: flex; flex-direction: column; gap: 20px; margin-bottom: 24px; }
    .control-group { display: flex; flex-direction: column; gap: 8px; }
    .control-group label { font-size: 14px; font-weight: 600; color: var(--ml-dark); }
    .options-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .option-btn { background: var(--ml-gray-light); border: 1px solid var(--ml-gray-medium); padding: 8px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; color: var(--ml-gray-text); cursor: pointer; transition: all 0.2s; }
    .option-btn.selected { background: var(--ml-yellow); border-color: var(--ml-yellow); color: var(--ml-dark); }

    .summary-box { background: #fdfae5; border: 1px solid #f6e696; padding: 12px; border-radius: 4px; font-size: 14px; font-weight: 600; color: #6d6318; text-align: center; }
    .alert-box { background: #ffebee; border: 1px solid #ffcdd2; padding: 10px; border-radius: 4px; font-size: 12px; font-weight: 600; color: #c62828; text-align: center; margin-bottom: 15px; }
    
    .actions { display: flex; gap: 12px; margin-top: 8px; }
    .actions .btn { flex: 1; }
    .status-panel { font-size: 14px; text-align: center; margin-top: 10px; font-weight: bold; color: var(--ml-blue); min-height: 40px; }

    .queue-header { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding-top: 20px; border-top: 1px solid var(--ml-gray-medium); margin-bottom: 12px; }
    .queue-header h3 { font-size: 16px; font-weight: 600; }
    .clear-btn { background: transparent; border: none; color: var(--ml-blue); font-size: 13px; cursor: pointer; }
    .clear-btn:hover { text-decoration: underline; }

    .queue-list { display: flex; flex-direction: column; gap: 8px; max-height: 400px; overflow-y: auto; padding-right: 5px; }
    .queue-list::-webkit-scrollbar { width: 6px; }
    .queue-list::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
    .queue-list::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }

    .queue-item { display: flex; align-items: center; justify-content: space-between; padding: 12px; border: 1px solid var(--ml-gray-medium); border-radius: 4px; background: #fff; }
    .item-info { display: flex; flex-direction: column; gap: 4px; overflow: hidden; margin-right: 10px; flex: 1; }
    .item-url { font-size: 13px; color: var(--ml-dark); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: monospace; }
    .item-meta { display: flex; align-items: center; gap: 8px; font-size: 11px; }

    .status-badge { padding: 2px 6px; border-radius: 10px; font-weight: 600; text-transform: uppercase; font-size: 10px; }
    .status-pendente    { background: #e0e0e0; color: #555; }
    .status-processando { background: #fff0b3; color: #8a7300; }
    .status-enviado     { background: #cce5ff; color: #004085; }
    .status-erro        { background: #ffcccc; color: #a30000; }
    .time-added { color: var(--ml-gray-text); }
    .remove-item { background: transparent; border: none; color: var(--ml-gray-text); cursor: pointer; font-size: 18px; padding: 4px; flex-shrink: 0; }
    .remove-item:hover { color: red; }
    @media (max-width: 900px) { .container { grid-template-columns: 1fr; } .webhook-config input { width: 220px; } }
  </style>
</head>
<body>

  <header class="header">
    <h1>Estratégia de Disparos - ML</h1>
    <div class="webhook-config">
      <span class="webhook-label">URL do n8n:</span>
      <input type="text" id="webhookUrl" placeholder="https://seu-ngrok.ngrok-free.dev/webhook/receber-links-ml" value="https://glennie-gawsy-tori.ngrok-free.dev/webhook/conta-gotas-ml" />
    </div>
  </header>

  <div class="container">
    <div class="card">
      <h2>1. Adicionar Links à Fila</h2>
      <div class="input-group">
        <textarea id="linksInput" placeholder="Cole os links aqui..."></textarea>
        <button id="addBtn" class="btn btn-primary" onclick="adicionarLinks()">Adicionar à fila</button>
      </div>
    </div>

    <div class="card" id="queuePanel">
      <h2>2. Estratégia de Envio</h2>
      
      <div class="alert-box">⚠️ Mantenha esta aba aberta para que os Turnos funcionem.</div>

      <div class="controls">
        <div class="control-group">
          <label>Frequência (Turnos):</label>
          <div class="options-row" id="turnoOptions">
            <button class="option-btn selected" data-val="imediato">Imediato (Contínuo)</button>
            <button class="option-btn" data-val="mtn">Manhã (10h), Tarde (14h) e Noite (19h)</button>
            <button class="option-btn" data-val="1h">A cada 1 hora</button>
          </div>
        </div>

        <div class="control-group">
          <label>Posts por Turno (Tamanho do Lote):</label>
          <div class="options-row" id="loteOptions">
            <button class="option-btn selected" data-val="1">1 post</button>
            <button class="option-btn" data-val="3">3 posts</button>
            <button class="option-btn" data-val="5">5 posts</button>
          </div>
        </div>

        <div class="control-group">
          <label>Intervalo (entre os posts do lote):</label>
          <div class="options-row" id="intervaloOptions">
            <button class="option-btn selected" data-val="10">10 seg</button>
            <button class="option-btn" data-val="30">30 seg</button>
            <button class="option-btn" data-val="60">1 min</button>
            <button class="option-btn" data-val="300">5 min</button>
          </div>
        </div>

        <div class="summary-box" id="ResumoConfig">Resumo atualizando...</div>

        <div class="actions">
          <button id="startBtn" class="btn btn-yellow" onclick="iniciarEnvio()">Iniciar Estratégia</button>
          <button id="cancelBtn" class="btn btn-danger" onclick="cancelarEnvio()" disabled>Parar Tudo</button>
        </div>

        <div class="status-panel" id="statusEnvioTexto">Pronto para iniciar.</div>
      </div>

      <div class="queue-header">
        <h3>Fila (<span id="queueCount">0</span>)</h3>
        <button class="clear-btn" onclick="limparFila()">Limpar Fila</button>
      </div>
      <div class="queue-list" id="queueList"></div>
    </div>
  </div>

  <script>
    // ── Estado ──────────────────────────────────────────────
    let fila = [];
    let isSending = false;
    let proximoTurnoTimestamp = 0;
    
    let confTurno = 'imediato';
    let confTamanho = 1;
    let confIntervalo = 10;

    // ── Init ────────────────────────────────────────────────
    window.onload = function () {
      setupBtns('turnoOptions', v => { confTurno = v; atualizarResumo(); });
      setupBtns('loteOptions', v => { confTamanho = parseInt(v); atualizarResumo(); });
      setupBtns('intervaloOptions', v => { confIntervalo = parseInt(v); atualizarResumo(); });
      carregarDoStorage();
      atualizarResumo();
    };

    function setupBtns(id, cb) {
      const btns = document.getElementById(id).querySelectorAll('.option-btn');
      btns.forEach(b => b.addEventListener('click', function () {
        if (isSending) return;
        btns.forEach(x => x.classList.remove('selected'));
        this.classList.add('selected');
        cb(this.dataset.val);
      }));
    }

    function atualizarResumo() {
      let tText = confTurno === 'imediato' ? "continuamente" : (confTurno === 'mtn' ? "nos turnos das 10h, 14h e 19h" : "a cada 1 hora");
      let pText = confTamanho === 1 ? "1 post" : `${confTamanho} posts`;
      document.getElementById('ResumoConfig').innerText = `Estratégia: Enviar ${pText} ${tText}, aguardando ${confIntervalo}s entre eles.`;
    }

    // ── Utils de Tempo e Promessas (O Cérebro Novo) ─────────
    function formatTime(sec) {
      let h = Math.floor(sec / 3600);
      let m = Math.floor((sec % 3600) / 60);
      let s = sec % 60;
      if (h > 0) return `${h}h ${m}m ${s}s`;
      if (m > 0) return `${m}m ${s}s`;
      return `${s}s`;
    }

    function sleep(ms) {
      return new Promise(resolve => setTimeout(resolve, ms));
    }

    function runGoogleScript(funcName, ...args) {
      return new Promise((resolve, reject) => {
        google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[funcName](...args);
      });
    }

    // ── Persistência e Fila ─────────────────────────────────
    function salvarStorage() { sessionStorage.setItem('ml_fila', JSON.stringify(fila)); }
    function carregarDoStorage() {
      try { const saved = sessionStorage.getItem('ml_fila'); if (saved) fila = JSON.parse(saved); } catch(e) { fila = []; }
      renderizar();
    }

    function adicionarLinks() {
      const ta = document.getElementById('linksInput');
      const validos = ta.value.split(/\r?\n/).map(l => l.trim()).filter(l => l.includes('mercadolivre.com') || l.includes('mercadolibre.com'));
      if (validos.length === 0) return alert('Nenhum link válido.');
      validos.forEach(url => fila.push({ id: crypto.randomUUID(), url, status: 'pendente', dataAdicao: Date.now() }));
      ta.value = ''; salvarStorage(); renderizar();
    }

    function removerItem(id) { if(isSending) return; fila = fila.filter(i => i.id !== id); salvarStorage(); renderizar(); }
    function limparFila() { if(isSending) return; fila = []; salvarStorage(); renderizar(); }

    function renderizar() {
      const container = document.getElementById('queueList');
      document.getElementById('queueCount').innerText = fila.length;
      if (fila.length === 0) { container.innerHTML = '<div style="padding:15px;color:#666;text-align:center;font-size:14px;">A fila está vazia.</div>'; return; }
      
      container.innerHTML = '';
      fila.forEach(item => {
        const div = document.createElement('div');
        div.className = 'queue-item'; div.id = `item-${item.id}`;
        div.innerHTML = `
          <div class="item-info">
            <span class="item-url">${item.url.substring(0, 52) + '...'}</span>
            <div class="item-meta"><span class="status-badge status-${item.status}">${item.status}</span></div>
          </div>
          <button class="remove-item" onclick="removerItem('${item.id}')" ${isSending ? 'disabled' : ''}>×</button>
        `;
        container.appendChild(div);
      });
    }

    function setStatus(id, status) {
      let el = document.getElementById(`item-${id}`);
      if (el) { el.querySelector('.status-badge').className = `status-badge status-${status}`; el.querySelector('.status-badge').innerText = status; }
      let item = fila.find(x => x.id === id); if (item) item.status = status;
      salvarStorage();
    }

    // ── Lógica de Agendamento e Disparo ──────────────────────
    async function iniciarEnvio() {
      if (!document.getElementById('webhookUrl').value.trim()) return alert('Insira a URL do n8n.');
      if (fila.filter(i => i.status === 'pendente' || i.status === 'erro').length === 0) return alert('Fila vazia.');

      isSending = true;
      proximoTurnoTimestamp = 0; // Zera para calcular o próximo
      document.getElementById('startBtn').disabled = true;
      document.getElementById('cancelBtn').disabled = false;
      
      processarFila(); // Inicia o laço contínuo
    }

    function cancelarEnvio() {
      isSending = false;
      document.getElementById('startBtn').disabled = false;
      document.getElementById('cancelBtn').disabled = true;
      document.getElementById('statusEnvioTexto').innerText = '🛑 Estratégia pausada.';
      renderizar();
    }

    function calcularProximoTurno() {
      if (confTurno === '1h') {
          proximoTurnoTimestamp = Date.now() + 3600 * 1000;
      } else if (confTurno === 'mtn') {
          let agora = new Date();
          let hora = agora.getHours();
          let proxHora = 10;
          
          if (hora < 10) proxHora = 10;
          else if (hora < 14) proxHora = 14;
          else if (hora < 19) proxHora = 19;
          else proxHora = 10;

          let alvo = new Date();
          if (proxHora === 10 && hora >= 19) alvo.setDate(alvo.getDate() + 1); // Dia seguinte
          alvo.setHours(proxHora, 0, 0, 0);
          proximoTurnoTimestamp = alvo.getTime();
      }
    }

    async function processarFila() {
      while (isSending) {
        let pendentes = fila.filter(i => i.status === 'pendente' || i.status === 'erro');
        if (pendentes.length === 0) {
          document.getElementById('statusEnvioTexto').innerText = "✅ Todos os links foram enviados!";
          break;
        }

        // 1. Aguarda o Turno (Se não for Imediato)
        if (confTurno !== 'imediato') {
          if (proximoTurnoTimestamp === 0) calcularProximoTurno(); // Calcula qual é o próximo horário
          
          while (isSending && Date.now() < proximoTurnoTimestamp) {
            let dif = Math.floor((proximoTurnoTimestamp - Date.now()) / 1000);
            document.getElementById('statusEnvioTexto').innerText = `⏳ Turno Agendado... Iniciando lote em ${formatTime(dif)}`;
            await sleep(1000); // Atualiza o relógio a cada 1 segundo
          }
        }
        
        if (!isSending) break;

        // 2. Monta o Lote do Turno
        pendentes = fila.filter(i => i.status === 'pendente' || i.status === 'erro');
        let loteAtual = pendentes.slice(0, confTamanho);
        let webhook = document.getElementById('webhookUrl').value.trim();

        // 3. Dispara os posts do lote
        for (let i = 0; i < loteAtual.length; i++) {
          if (!isSending) break;
          let item = loteAtual[i];
          
          setStatus(item.id, 'processando');
          document.getElementById('statusEnvioTexto').innerText = `🚀 Turno Ativo: Enviando post ${i+1} de ${loteAtual.length}...`;

          try {
            await runGoogleScript('enviarLoteParaN8n', webhook, [item.url]);
            setStatus(item.id, 'enviado');
          } catch (e) {
            setStatus(item.id, 'erro');
          }

          // Intervalo entre os posts (pula se for o último do lote)
          if (i < loteAtual.length - 1 && isSending) {
            for (let s = confIntervalo; s > 0; s--) {
              if (!isSending) break;
              document.getElementById('statusEnvioTexto').innerText = `Post enviado. Aguardando ${s}s para o próximo post do lote...`;
              await sleep(1000);
            }
          }
        }

        if (!isSending) break;

        // 4. Prepara a próxima rodada
        calcularProximoTurno();
        if (confTurno === 'imediato') {
          document.getElementById('statusEnvioTexto').innerText = `Lote concluído. Iniciando o próximo em 3s...`;
          await sleep(3000); // Pequena pausa no modo imediato para não bugar
        }
      }

      cancelarEnvio(); // Reseta os botões quando a fila acaba
    }
  </script>
</body>
</html>