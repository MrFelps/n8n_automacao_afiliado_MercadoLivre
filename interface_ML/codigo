const MEU_CHAT_ID = "000"; 

function doGet() {
  return HtmlService.createHtmlOutputFromFile('index')
      .setTitle('Painel Lotes - ML')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function enviarLoteParaN8n(webhookUrl, urls) {
  let sucessos = 0;
  
  for (let i = 0; i < urls.length; i++) {
    let payload = {
      "url": urls[i],
      "chat_id": MEU_CHAT_ID,
      "username": "Painel Web"
    };

    let options = {
      "method": "post",
      "contentType": "application/json",
      "payload": JSON.stringify(payload),
      "muteHttpExceptions": true 
    };

    try {
      UrlFetchApp.fetch(webhookUrl, options);
      sucessos++;
      Utilities.sleep(1500); 
    } catch (e) {
      Logger.log("Erro no envio da URL: " + urls[i]);
    }
  }
  
  if (sucessos < urls.length) {
    throw new Error("Alguns links do lote falharam.");
  }
  
  return sucessos;
}